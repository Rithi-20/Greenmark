{
    "version": 2,
    "builds": [
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "client/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://greenmark-iota.vercel.app/api/$1"
        },
        {
            "source": "/uploads/(.*)",
            "destination": "https://greenmark-iota.vercel.app/uploads/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/client/$1"
        }
    ]
}